{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_repo}",
    "sources": "${mod_repo}",
    "issues": "${mod_repo}/issues"
  },
  "license": "${mod_license}",
  "icon": "${mod_icon}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.maxoduke.mods.potioncauldron.FabricInitializer"
    ],
    "client": [
      "dev.maxoduke.mods.potioncauldron.FabricInitializer"
    ],
    "modmenu": [
      "dev.maxoduke.mods.potioncauldron.config.gui.ModMenu"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "accessWidener": "${mod_id}.classtweaker",
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25"
  }
}
